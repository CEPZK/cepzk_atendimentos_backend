# =============================================================================
# Credenciais do Supabase — copie para .env e preencha.
# Onde encontrar: Dashboard do Supabase → Project Settings → API
# =============================================================================

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Obrigatória apenas para processos fora do navegador (jobs, scripts de
# administração). NUNCA exponha a service role no frontend.
# SUPABASE_SERVICE_ROLE_KEY=
